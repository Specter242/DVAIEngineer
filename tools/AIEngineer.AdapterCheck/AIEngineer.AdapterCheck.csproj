<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Checks, against the installed game's assemblies under Mono, the members
    the mod reaches by reflection or by name (scripts/check-adapter.sh).
    Game assemblies are copied to bin/ (gitignored) so Mono can load them.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- PUBLIC_RELEASE=1 in scripts/check-adapter.sh: the checks run on the public release's build. -->
  <PropertyGroup Condition="'$(PublicRelease)' == 'true'">
    <DefineConstants>$(DefineConstants);PUBLIC_RELEASE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AIEngineer/AIEngineer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(DvModManagerDir)/0Harmony.dll" />
    <Reference Include="UnityModManager" HintPath="$(DvModManagerDir)/UnityModManager.dll" />
    <Reference Include="Assembly-CSharp" HintPath="$(DvManagedDir)/Assembly-CSharp.dll" />
    <Reference Include="DV.RailTrack" HintPath="$(DvManagedDir)/DV.RailTrack.dll" />
    <Reference Include="DV.Simulation" HintPath="$(DvManagedDir)/DV.Simulation.dll" />
    <Reference Include="DV.Utils" HintPath="$(DvManagedDir)/DV.Utils.dll" />
    <Reference Include="UnityEngine" HintPath="$(DvManagedDir)/UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(DvManagedDir)/UnityEngine.CoreModule.dll" />
    <Reference Include="System.Xml" />
  </ItemGroup>

</Project>
